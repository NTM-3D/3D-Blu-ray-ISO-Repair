#include <windows.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     BR3D_VER_MAJOR,BR3D_VER_MINOR,BR3D_VER_PATCH,0
 PRODUCTVERSION  BR3D_VER_MAJOR,BR3D_VER_MINOR,BR3D_VER_PATCH,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "NTM-3D"
            VALUE "FileDescription",  "3D Blu-ray ISO Repair"
            VALUE "FileVersion",      BR3D_VERSION_FULL
            VALUE "InternalName",     "3d_bluray_iso_repair"
            VALUE "OriginalFilename", BR3D_EXE_NAME
            VALUE "ProductName",      "3D Blu-ray ISO Repair"
            VALUE "ProductVersion",   BR3D_VERSION
            VALUE "LegalCopyright",   "NTM-3D"
            VALUE "Author",           "NTM-3D"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4b0
    END
END
